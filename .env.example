# Copy this file to .env and fill in the values (.env is git-ignored).
# On GitHub, add every name you fill in (same spelling) under: Settings → Secrets and variables → Actions → Secrets → New repository secret

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Group chat ID (negative number, e.g. -1001234567890 or -123456789)
# Same name is used as the GitHub secret
# Get it from: https://api.telegram.org/bot<TOKEN>/getUpdates  →  "chat":{"id": ... }
QA_JOB_SEARCH_TELEGRAM_CHAT_ID=

# --- Email digest (Gmail) — sent alongside Telegram; leave blank to skip email ---
# The Gmail address that SENDS the alert (a separate account just for this is best)
SMTP_USER=
# A Gmail "App Password" for that account — NOT its normal password.
# Turn on 2-Step Verification, then: myaccount.google.com/apppasswords → create → copy the 16 letters (spaces don't matter)
SMTP_PASSWORD=
# Who RECEIVES the alert (her address). Several? Separate with commas.
EMAIL_TO=
# OPTIONAL: hidden copy to you, so you see what she gets
EMAIL_BCC=

# --- JSearch (RapidAPI) — Google Jobs results incl. LinkedIn / Naukri / Indeed postings ---
# rapidapi.com → search "JSearch" → Subscribe to the free (Basic) plan → copy "X-RapidAPI-Key"
RAPIDAPI_KEY=

# --- Adzuna — OPTIONAL (free tier is only 25 test calls; full access needs a card) ---
# Leave blank to skip. The script ignores any source whose key is empty.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
